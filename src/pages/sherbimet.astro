---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import Split from '../components/Split.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { serviceGroups } from '../data/services';

// TODO: check that these match what the Premium package really includes.
const extras = [
  { icon: 'home', title: 'Banim privat', text: 'Një hapësirë private për banorin.' },
  { icon: 'user', title: 'Shërbimi juridik', text: 'Mbështetje për çështje ligjore dhe dokumente.' },
  { icon: 'stethoscope', title: 'Shërbimi spitalor', text: 'Mbështetje gjatë vizitave dhe shërbimeve spitalore.' },
] as const;
---

<Layout
  title="Shërbimet – Qendra e Kujdesit Duart e Arta"
  description="Banim, ushqim, kujdes personal dhe mjekësor, terapi, mbështetje psikologjike dhe aktivitete në Qendrën e Kujdesit Duart e Arta."
>
  <PageBanner
    image="/img5.webp"
    eyebrow="Shërbimet tona"
    title="Kujdes i plotë, çdo ditë"
    lead="Gjithçka që një banor ka nevojë, nga dhoma dhe vakti i ditës deri te kujdesi shëndetësor dhe shoqëria."
  />

  {serviceGroups.map((group, i) => (
    <Split image={group.image} alt={group.alt} reverse={i % 2 === 1} tint={i % 2 === 1}>
      <h2>{group.title}</h2>
      <p class="intro">{group.intro}</p>
      <ul class="items">
        {group.services.map((service) => (
          <li>
            <Icon name={service.icon} size={26} />
            <div>
              <h3>{service.title}</h3>
              <p>{service.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </Split>
  ))}

  <section class="section section--tint">
    <div class="container">
      <h2 class="extras-title">Shërbime shtesë në paketën Premium</h2>
      <ul class="extras">
        {extras.map(({ icon, title, text }) => (
          <li>
            <Icon name={icon} size={26} />
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
      <a href="/paketat" class="text-link">
        Shihni paketat
        <Icon name="arrow-right" size={18} strokeWidth={2} />
      </a>
    </div>
  </section>

  <Cta plain />
</Layout>

<style>
  .intro {
    margin: 1rem 0 2rem;
    max-width: 34rem;
    color: var(--muted);
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .items li {
    display: flex;
    gap: 1.25rem;
    padding-block: 1.4rem;
    border-top: 1px solid #cbd6e4;
  }
  .items :global(svg),
  .extras :global(svg) {
    flex: none;
    color: var(--blue-700);
  }
  .items :global(svg) {
    margin-top: 0.15rem;
  }
  .items h3 {
    margin-bottom: 0.3rem;
    font-size: 1.15rem;
  }
  .items p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.6;
  }

  .extras-title {
    margin-bottom: 2.5rem;
  }
  .extras {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
  }
  .extras li {
    padding-top: 1.5rem;
    border-top: 1px solid #cbd6e4;
  }
  .extras :global(svg) {
    margin-bottom: 1rem;
  }
  .extras h3 {
    margin-bottom: 0.4rem;
    font-size: 1.15rem;
  }
  .extras p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }

  @media (max-width: 760px) {
    .extras {
      grid-template-columns: 1fr;
    }
  }
</style>