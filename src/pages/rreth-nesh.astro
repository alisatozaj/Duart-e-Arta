---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import Split from '../components/Split.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';

const values = [
  {
    icon: 'heart',
    title: 'Respekt',
    text: 'Çdo banor ka historinë dhe zakonet e veta, dhe ne i trajtojmë me dinjitet.',
  },
  {
    icon: 'shield-check',
    title: 'Siguri',
    text: 'Një ambient i qetë, i pastër dhe i sigurt, ku banorët ndihen rehat.',
  },
  {
    icon: 'hand-heart',
    title: 'Ngrohtësi',
    text: 'Kujdesi ynë vjen me durim, mirëkuptim dhe një fjalë të mirë.',
  },
  {
    icon: 'message-circle',
    title: 'Bashkëpunim me familjen',
    text: 'Familjarët janë pjesë e kujdesit. I dëgjojmë dhe punojmë bashkë me ta.',
  },
] as const;

const team = [
  {
    icon: 'user',
    title: 'Drejtor',
    text: 'Koordinon dhe organizon punën e qendrës.',
  },
  {
    icon: 'stethoscope',
    title: 'Infermier',
    text: 'Ndjek nevojat shëndetësore dhe kujdesin infermieror.',
  },
  {
    icon: 'utensils',
    title: 'Kuzhinier',
    text: 'Përgatit ushqime sipas nevojave të banorëve.',
  },
  {
    icon: 'heart-handshake',
    title: 'Kujdestarë',
    text: 'Ofrojnë ndihmë dhe përkujdesje në aktivitetet e përditshme.',
  },
  {
    icon: 'sparkles',
    title: 'Sanitare',
    text: 'Kujdesen për pastërtinë dhe higjienën e ambienteve.',
  },
] as const;

const careServices = [
  'Asistencë në aktivitetet e përditshme',
  'Higjienë personale dhe kujdes shëndetësor',
  'Ushqim i përshtatur sipas nevojave',
  'Mbështetje dhe shoqërim',
  'Ambient i sigurt, i pastër dhe i ngrohtë',
] as const;

const careGroups = [
  {
    icon: 'users',
    title: 'Të moshuarit',
    text: 'Mbështetje për nevojat e përditshme, duke respektuar ritmin dhe zakonet e çdo personi.',
  },
  {
    icon: 'accessibility',
    title: 'Personat me aftësi të kufizuara',
    text: 'Një ambient gjithëpërfshirës, ku secili merr ndihmën dhe vëmendjen që i duhet.',
  },
] as const;
---

<Layout
  title="Rreth Nesh – Qendra e Kujdesit Duart e Arta"
  description="Njihuni me misionin, ekipin, vlerat dhe shërbimet e Qendrës së Kujdesit Duart e Arta në Sauk, Tiranë."
>
  <PageBanner
    image="/img2.jpg"
    eyebrow="Rreth nesh"
    title="Qendra e Kujdesit Duart e Arta"
    lead="Duart që kujdesen, zemrat që duan. Një ambient ku përkujdesja, respekti dhe ngrohtësia janë pjesë e çdo dite."
  />

  <!-- Misioni ynë -->
  <Split image="/img3.jpg" alt="Banorë dhe staf të Qendrës së Kujdesit Duart e Arta">
    <h2 class="mission-title">Një vend ku çdo njeri ndihet i vlerësuar.</h2>

    <p>
      Duart e Arta është një qendër e krijuar me dashuri dhe përgjegjësi, për
      t'u ofruar të moshuarve dhe personave me aftësi të kufizuara një ambient të
      sigurt, të qetë dhe familjar.
    </p>

    <p>
      Kujdesemi për nevojat personale dhe shëndetësore, por edhe për gjërat e
      vogla që e bëjnë ditën më të bukur: një bisedë, një vakt i këndshëm, shoqëria.
    </p>

    <p class="mission-quote">"Duart që kujdesen, zemrat që duan."</p>
  </Split>

  <!-- Ekipi ynë -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-heading">
        <h2>Njihuni me ekipin tonë</h2>
        <p class="section-lead">
          Një staf i përkushtuar, ku çdo anëtar ka një rol të rëndësishëm.
        </p>
      </div>

      <ul class="team">
        {team.map(({ icon, title, text }) => (
          <li>
            <div class="team-icon">
              <Icon name={icon} size={30} />
            </div>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Për kë kujdesemi -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Kujdes që merr parasysh çdo individ</h2>
        <p class="section-lead">
          Mbështetja jonë përshtatet me nevojat e secilit person.
        </p>
      </div>

      <div class="care-groups">
        {careGroups.map(({ icon, title, text }) => (
          <article class="care-card">
            <div class="care-icon">
              <Icon name={icon} size={34} />
            </div>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Shërbimet dhe kujdesi -->
  <section class="section section--tint">
    <div class="container services-grid">
      <div class="services-intro">
        <h2>Vëmendje ndaj nevojave të përditshme</h2>
        <p>
          Banorët kanë mbështetjen që u nevojitet, shoqërinë dhe një ambient
          të pastër, të sigurt dhe plot respekt.
        </p>
      </div>

      <ul class="care-list">
        {careServices.map((service) => (
          <li>
            <Icon name="check-circle" size={22} />
            <span>{service}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Vlerat tona -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Vlerat tona</h2>
        <p class="section-lead">
          Vlerat që na udhëheqin çdo ditë.
        </p>
      </div>

      <ul class="values">
        {values.map(({ icon, title, text }) => (
          <li>
            <Icon name={icon} size={28} />
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Cta />
</Layout>

<style>
  .section-heading {
    max-width: 720px;
    margin-bottom: 3.5rem;
  }

  .section-heading h2 {
    margin-bottom: 1.1rem;
  }

  .section-lead {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
  }

  /* Mission */
  .mission-title {
    margin-bottom: 1.5rem;
  }

  .mission-quote {
    margin-top: 1.75rem !important;
    color: var(--blue-900) !important;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    font-style: italic;
  }

  /* Team */
  .team {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team li {
    min-width: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .team-icon,
  .care-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    margin-bottom: 1.25rem;
    border: 1px solid var(--gold-500);
    border-radius: 50%;
    color: var(--blue-700);
    background: var(--surface);
  }

  .team h3,
  .care-card h3 {
    margin-bottom: 0.55rem;
    font-size: 1.15rem;
  }

  .team p,
  .care-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
  }

  /* Care groups */
  .care-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .care-card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }

  .care-card .care-icon {
    flex: 0 0 58px;
    margin: 0;
  }

  /* Services */
  .services-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
  }

  .services-intro h2 {
    margin-bottom: 1.25rem;
  }

  .services-intro > p:last-child {
    max-width: 34rem;
    margin: 0;
    color: var(--muted);
  }

  .care-list {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .care-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }

  .care-list :global(svg) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--blue-700);
  }

  /* Values */
  .values {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .values li {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .values :global(svg) {
    margin-bottom: 1rem;
    color: var(--blue-700);
  }

  .values h3 {
    margin-bottom: 0.5rem;
    font-size: 1.15rem;
  }

  .values p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }

  @media (max-width: 900px) {
    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .care-groups {
      grid-template-columns: 1fr;
    }

    .care-card {
      padding: 1.5rem;
      gap: 1rem;
    }

    .values {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>