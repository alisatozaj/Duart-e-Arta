---
// A section with one square photo next to some content (the slot).
// Same photo size and proportions as the About section on the home page.
interface Props {
  alt: string;
  image: string; // set it on every page, e.g. image="/rreth-nesh-1.jpg" (file in /public)
  reverse?: boolean;
  tint?: boolean;
}

const { alt, image, reverse = false, tint = false } = Astro.props;
---

<section class:list={['section', { 'section--tint': tint }]}>
  <div class:list={['container', 'split', { reverse }]}>
    <div class="photo-wrapper">
      <img
        class="photo"
        src={image}
        alt={alt}
        width="800"
        height="800"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="split-text">
      <slot />
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .split.reverse .photo-wrapper {
    order: 2;
  }

  /* Large square image wrapper (identical to About) */
  .photo-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 16px;
  }
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 900px) {
    .split,
    .split.reverse {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .split.reverse .photo-wrapper {
      order: 0;
    }
    .photo-wrapper {
      max-width: 600px;
      margin-inline: auto;
    }
  }
</style>
