---
import Icon from './Icon.astro';

// TODO: replace the placeholder photos with real ones, e.g. /gallery-1.jpg ...
const photos = [
  { src: '/kopshti.jpeg', alt: 'Një banor në kopshtin e qendrës', caption: 'Kopshti ynë' },
  { src: '/aktivitete.jpeg', alt: 'Banorët gjatë një aktiviteti së bashku', caption: 'Aktivitete së bashku' },
  { src: '/dhoma.jpeg', alt: 'Dhoma e rehatshme në Duart e Arta', caption: 'Dhoma të rehatshme' },
  { src: '/img.jpg', alt: 'Një banore së bashku me kujdestaren', caption: 'Kohë dhe kujdes' },
];
---

<section class="section section--tint" id="galeria">
  <div class="container">
    <header class="head">
      <div>
        <p class="eyebrow">Jeta në Duart e Arta</p>
        <h2>Çdo ditë, momente që kanë vlerë.</h2>
        <p class="sub">
          Jo thjesht një rutinë, por ditë të mbushura me shoqëri, qetësi dhe gjëra
          të vogla që sjellin gëzim.
        </p>
      </div>
      <a href="#kontakt" class="text-link">
        Ejani të na vizitoni
        <Icon name="arrow-right" size={18} strokeWidth={2} />
      </a>
    </header>

    <div class="grid">
      {photos.map((photo, i) => (
        <figure class={`tile tile-${i + 1}`}>
          <img src={photo.src} alt={photo.alt} width="800" height="600" loading="lazy" decoding="async" />
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .head h2 {
    margin-bottom: 1rem;
  }
  .sub {
    margin: 0;
    max-width: 32rem;
    color: var(--muted);
  }

  /* One tall photo on the left, one wide and two small on the right */
  .grid {
    display: grid;
    grid-template-columns: repeat(14, 1fr);
    grid-template-rows: repeat(2, clamp(180px, 24vw, 280px));
    gap: 0.65rem;
  }
  .tile-1 { grid-column: 1 / 7;   grid-row: 1 / 3; }
  .tile-2 { grid-column: 7 / 15;  grid-row: 1; }
  .tile-3 { grid-column: 7 / 11;  grid-row: 2; }
  .tile-4 { grid-column: 11 / 15; grid-row: 2; }

  .tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 10px;
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .tile:hover img {
    transform: scale(1.03);
  }
  /* dark fade at the bottom so the caption stays readable */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 28, 56, 0.65), transparent 50%);
    pointer-events: none;
  }
  figcaption {
    position: absolute;
    left: 1.1rem;
    bottom: 1rem;
    z-index: 1;
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
  }

  @media (max-width: 760px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
      grid-auto-rows: 180px;
    }
    .tile-1 { grid-column: 1 / 3; grid-row: auto; }
    .tile-2 { grid-column: 1 / 3; grid-row: auto; }
    .tile-3,
    .tile-4 { grid-column: auto; grid-row: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile img {
      transition: none;
    }
    .tile:hover img {
      transform: none;
    }
  }
</style>