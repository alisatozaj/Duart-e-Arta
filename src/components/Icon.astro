---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
}

const { name, size = 24, strokeWidth = 1.8 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <Fragment set:html={icons[name]} />
</svg>