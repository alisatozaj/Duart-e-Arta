---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { navLinks } from '../data/nav';

const year = new Date().getFullYear();

const socials = [
  { name: 'Facebook', icon: 'facebook', href: site.social.facebook },
  { name: 'Instagram', icon: 'instagram', href: site.social.instagram },
].filter((s) => s.href);

const contact = [
  { icon: 'phone', text: site.phone, href: site.phoneHref },
  { icon: 'mail', text: site.email, href: `mailto:${site.email}` },
  { icon: 'map-pin', text: site.address, href: undefined },
] as const;
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="brand-col">
        <a href="/" class="brand" aria-label="Duart e Arta – Kreu">
          <span class="logo"><img src="/logo.png" alt="" width="52" height="52" /></span>
          <span class="brand-text">
            <span class="brand-small">Qendra e Kujdesit</span>
            <span class="brand-big">Duart e Arta</span>
          </span>
        </a>
        <p>Një shtëpi ku çdo njeri ndihet i respektuar, i sigurt dhe i dashur.</p>

        {socials.length > 0 && (
          <ul class="socials">
            {socials.map(({ name, icon, href }) => (
              <li>
                <a href={href} aria-label={name} target="_blank" rel="noopener noreferrer">
                  <Icon name={icon} size={18} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <nav aria-label="Navigimi në fund të faqes">
        <h3>Navigimi</h3>
        <ul>
          {navLinks.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h3>Na kontaktoni</h3>
        <ul class="contact">
          {contact.map(({ icon, text, href }) => {
            const Tag = href ? 'a' : 'span';
            return (
              <li>
                <Icon name={icon} size={18} />
                <Tag href={href}>{text}</Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </div>

    <p class="copyright">© {year} Duart e Arta. Të gjitha të drejtat e rezervuara.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    color: rgba(255, 255, 255, 0.72);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    font-size: 0.97rem;
  }
  .top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr;
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
    padding-bottom: 3rem;
  }

  h3 {
    margin-bottom: 1.1rem;
    font-size: 1.05rem;
    color: #fff;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  a {
    transition: color 0.2s;
  }
  a:hover {
    color: #fff;
  }

  /* brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }
  /* the logo has a white background, so it sits on a white tile */
  .logo {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 4px;
    background: #fff;
    border-radius: 12px;
  }
  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .brand-small {
    margin-bottom: 0.3rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  .brand-big {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .brand-col p {
    max-width: 22rem;
    margin: 1.25rem 0 0;
    line-height: 1.6;
  }

  .socials {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    transition: border-color 0.2s, color 0.2s;
  }
  .socials a:hover {
    border-color: var(--gold-500);
  }

  .contact li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .contact :global(svg) {
    flex: none;
    color: var(--gold-500);
  }

  .copyright {
    margin: 0;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 820px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>